---
/**
 * NightSand — la arena del puerto, de noche (escena del Footer · sand-night).
 *
 * La orilla de ESTE mar (el cuerpo del sitio), no una escena aparte. Tras el
 * rediseño «un solo lienzo» (Seascape: agua y burbujas difusas), las olas SVG
 * del footer sonaban a bespoke; aquí el mar entrega a la arena por VARIAS LÍNEAS
 * DE MAREA apiladas —como en una playa real: la más baja es la marca fresca del
 * agua, y hacia el mar se suceden otras cada vez más oscuras hasta volverse del
 * color del mar—. Cada filo tiene su propia forma orgánica e irregular; el color
 * de cada banda se rellena OPACO hasta su filo y el blur lo vuelve un degradado
 * SUAVE que sigue la curva (el paso mar→arena ondula, no es una línea recta).
 *
 * La arena se ve ARENA porque no es un color liso: un MOTEADO tonal
 * (.ns-mottle) más un GRANO fino (.ns-grain), ambos ruido `feTurbulence`
 * incrustado con la región del filtro fijada al mosaico (para que no se vea la
 * costura de repetición). Un rescoldo cálido del atardecer se posa en la orilla.
 *
 * Uso: hijo directo del footer con position:relative (z-index 0, aria-hidden).
 * El contenido del footer debe ir por encima (z-index >= 1). Todo estático:
 * nada que apagar con reduced-motion.
 */
/* NightSand.astro */
import "./NightSand.css";

const W = 1440;

const makeEdge = (baseY: number, segs: { dx: number; a: number }[]): string => {
  let x = 0;
  let d = `M 0 ${baseY}`;
  for (const s of segs) {
    const cx1 = x + s.dx / 3;
    const cx2 = x + (2 * s.dx) / 3;
    const y = baseY + s.a;
    x += s.dx;
    d += ` C ${cx1} ${y} ${cx2} ${y} ${x} ${baseY}`;
  }
  return d;
};

const fillAbove = (edge: string): string => `${edge} L ${W} 0 L 0 0 Z`;

/* Curva orgánica para la entrada del mar */
const seaEdge = {
  baseY: 40,
  segs: [
    { dx: 200, a: -12 },
    { dx: 180, a: 18 },
    { dx: 260, a: -15 },
    { dx: 210, a: 22 },
    { dx: 150, a: -10 },
    { dx: 220, a: 14 },
    { dx: 220, a: -12 },
  ],
};

const shores = [
  {
    baseY: 180,
    mix: 22,
    segs: [
      { dx: 210, a: 24 },
      { dx: 170, a: -14 },
      { dx: 250, a: 32 },
      { dx: 160, a: -18 },
      { dx: 140, a: 12 },
      { dx: 290, a: -10 },
      { dx: 220, a: 26 },
    ],
  },
  {
    baseY: 120,
    mix: 42,
    segs: [
      { dx: 180, a: -16 },
      { dx: 260, a: 22 },
      { dx: 150, a: -12 },
      { dx: 300, a: 26 },
      { dx: 170, a: -18 },
      { dx: 200, a: 14 },
      { dx: 180, a: -10 },
    ],
  },
  {
    baseY: 62,
    deep: true,
    segs: [
      { dx: 240, a: 16 },
      { dx: 160, a: -14 },
      { dx: 280, a: 20 },
      { dx: 190, a: -10 },
      { dx: 130, a: 14 },
      { dx: 240, a: -16 },
      { dx: 200, a: 12 },
    ],
  },
];
---

<div class="nightsand" aria-hidden="true">
  <span class="ns-water-fade"></span>

  <svg
    class="ns-shore"
    viewBox={`0 0 ${W} 240`}
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="ns-deep" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--palette-night)"></stop>
        <stop
          offset="1"
          style="stop-color: color-mix(in oklab, var(--palette-night) 42%, var(--palette-sand-night))"
        ></stop>
      </linearGradient>

      <!-- Nuevo degradado orgánico para la disolución del mar -->
      <linearGradient id="ns-sea-blend" x1="0" y1="0" x2="0" y2="1">
        <stop
          offset="0%"
          style="stop-color: color-mix(in oklab, var(--palette-deep) 26%, var(--palette-night))"
        ></stop>
        <stop offset="100%" style="stop-color: var(--palette-night)"></stop>
      </linearGradient>
    </defs>

    <!-- Fondo fluido del mar respondiendo a la ondulación -->
    <path
      d={fillAbove(makeEdge(seaEdge.baseY, seaEdge.segs))}
      fill="url(#ns-sea-blend)"></path>

    {
      shores.map((s) => (
        <path
          d={fillAbove(makeEdge(s.baseY, s.segs))}
          style={
            s.deep
              ? "fill: url(#ns-deep)"
              : `fill: color-mix(in oklab, var(--palette-night) ${s.mix}%, var(--palette-sand-night))`
          }
        />
      ))
    }

    <path
      class="ns-shore-foam"
      d={makeEdge(shores[0].baseY, shores[0].segs)}
      fill="none"></path>
    <path
      class="ns-shore-foam ns-shore-foam--faint"
      d={makeEdge(shores[1].baseY, shores[1].segs)}
      fill="none"></path>
  </svg>

  <span class="ns-shading"></span>
  <span class="ns-mottle"></span>
  <span class="ns-grain"></span>
  <span class="ns-ember"></span>
</div>
