---
/**
 * Sun — el sol del descenso, medido como con un sextante.
 *
 * El sol baja con el scroll hasta ocultarse tras la línea del horizonte
 * (el borde inferior del cielo). Conforme se oculta, la masa del astro
 * queda recortada tras el horizonte, mientras el resplandor cálido (haze
 * y banda de fuego) permanece vibrando en el borde.
 *
 * Coreografía por scroll (CSS animation-timeline o lerp de --sun):
 * transform y opacity exclusivamente para rendimiento GPU. Con prefers-reduced-motion
 * o sin JS: postal estática con el sol posado sobre el horizonte.
 */
import "./Sun.css";
---

<div class="sunset" aria-hidden="true" data-sun-scene>
  <!-- El cielo: recorta al sol cuando cruza la línea del horizonte (bottom: 0) -->
  <div class="ss-sky">
    <div class="ss-sun">
      <span class="ss-halo"></span>
      <span class="ss-core"></span>

      <!-- El limbo del sextante: órbita punteada, arco graduado de 160° -->
      <svg class="ss-ring" viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg">
        <g class="ss-ring-rotor">
          <circle class="ss-ring-orbit" cx="110" cy="110" r="88" fill="none"></circle>
          <path
            class="ss-ring-limb"
            d="M 23.34 94.72 A 88 88 0 0 1 196.66 94.72"
            fill="none"></path>
          <g class="ss-ring-ticks">
            {
              Array.from({ length: 21 }).map((_, i) => (
                <line
                  x1="110"
                  y1="22"
                  x2="110"
                  y2={i % 5 === 0 ? "10" : "16"}
                  transform={`rotate(${-80 + i * 8} 110 110)`}
                />
              ))
            }
          </g>
          <g class="ss-index">
            <line x1="110" y1="12" x2="110" y2="2"></line>
            <path d="M 110 14 L 114.5 23 L 110 32 L 105.5 23 Z"></path>
          </g>
        </g>
      </svg>
    </div>
  </div>

  <!-- El resplandor en el borde del horizonte (permanece al ocultarse el astro) -->
  <span class="ss-haze"></span>
  <span class="ss-horizon"></span>

  <!-- La senda del sol: reflejo que titila sobre el agua tras la línea -->
  <div class="ss-glitter">
    <span class="ss-glitter-layer ss-glitter-layer--a"></span>
    <span class="ss-glitter-layer ss-glitter-layer--b"></span>
  </div>
</div>

<script>
  /**
   * Publica --sun (0 → 1) según el progreso de scroll respecto al cielo/hero.
   * Interpola suavemente con rAF. Con reduced-motion o si la API native animation-timeline
   * maneja el timeline, se mantiene sincronizado.
   */
  const scenes = document.querySelectorAll<HTMLElement>("[data-sun-scene]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  scenes.forEach((scene) => {
    let raf = 0;
    let inView = false;
    let current = -1;

    /**
     * El cielo y su altura se resuelven FUERA del bucle: no cambian al hacer
     * scroll, solo cuando el elemento cambia de tamaño. Medirlos dentro del
     * rAF obligaba a un reflow sincrónico por fotograma —leer geometría y
     * escribir `--sun` en el mismo frame es layout thrashing—, y el navegador
     * recalculaba sesenta veces por segundo un valor constante.
     */
    const sky = scene.closest(".sea-sky") || scene.parentElement;
    let skyHeight = 0;

    const measure = () => {
      skyHeight = sky ? sky.getBoundingClientRect().height : window.innerHeight;
    };

    /**
     * La posición de scroll también se cachea, y por el mismo motivo: leerla
     * dentro del bucle, después de haber escrito `--sun` en el fotograma
     * anterior, obliga al navegador a rehacer el layout para responder. El
     * evento `scroll` se despacha antes del rAF del mismo fotograma, así que
     * guardarla ahí no pierde ni un frame de sincronía.
     */
    let scrollY = window.scrollY;

    const target = (): number => {
      const raw = scrollY / ((skyHeight || window.innerHeight) * 0.95);
      return Math.min(1, Math.max(0, raw));
    };

    const loop = () => {
      const t = target();
      if (current < 0) current = t;
      current += (t - current) * 0.08;
      if (Math.abs(t - current) < 0.0003) current = t;
      scene.style.setProperty("--sun", current.toFixed(4));
      raf = inView ? requestAnimationFrame(loop) : 0;
    };

    const start = () => {
      if (!raf && inView && !reduceMotion.matches) {
        raf = requestAnimationFrame(loop);
      }
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    const parent = scene.closest("main") || scene.parentElement || document.body;
    const io = new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView) start();
        else stop();
      },
      { rootMargin: "20% 0px 20% 0px" },
    );
    io.observe(parent);

    // La altura se refresca sola cuando el cielo cambia de tamaño (rotación,
    // carga de fuentes, cambio de contenido). Un ResizeObserver lo cubre todo
    // sin sondeos y dispara una primera vez con el layout ya resuelto.
    if (sky && "ResizeObserver" in window) {
      new ResizeObserver(() => {
        measure();
        start();
      }).observe(sky);
    } else {
      measure();
      window.addEventListener("resize", measure, { passive: true });
    }

    window.addEventListener(
      "scroll",
      () => {
        scrollY = window.scrollY;
        start();
      },
      { passive: true },
    );

    reduceMotion.addEventListener("change", (e) => {
      if (e.matches) {
        stop();
        scene.style.removeProperty("--sun");
      } else {
        current = -1;
        start();
      }
    });
  });
</script>
