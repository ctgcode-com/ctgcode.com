---
/**
 * Home — composición de la página de inicio (única fuente de la verdad).
 *
 * Los archivos de ruta (pages/index.astro = es, pages/en/index.astro = en)
 * solo eligen el idioma; toda la estructura, textos (vía locales) y estilos
 * viven aquí una sola vez.
 *
 * HERO — "compilar el atardecer": un snippet se escribe en vivo en la ventana
 * de código y, al terminar, el sol tras ella se enciende (data-compiled).
 */
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../global/Navbar/Navbar.astro";
import Footer from "../../global/Footer/Footer.astro";
import LangNotice from "../../global/LangNotice/LangNotice.astro";
import About from "../../sections/About/About.astro";
import CTA from "../../ui/CTA/CTA.astro";
import Seascape from "../../backdrop/Seascape/Seascape.astro";
import SkyHeroFx from "../../backdrop/SkyHeroFx/SkyHeroFx.astro";
import Projects from "../../sections/Projects/Projects.astro";
import Services from "../../sections/Services/Services.astro";
import { locales } from "../../../data/i18n";
import "./Home.css";

interface Props {
  lang: keyof typeof locales;
}

const { lang } = Astro.props;
const t = locales[lang];
const title = `CTG Code — ${t.hero.title}`;
---

<Layout title={title} description={t.hero.description} pageName="home" lang={lang}>
  <Navbar lang={lang} pageName="home" />

  <main class="descent">
    <!-- El fondo compartido del sitio: mar + cielo del atardecer + sol de la
         marca + burbujas (el mismo que proyectos y servicios). Un solo lienzo,
         sin escenas bespoke por sección. -->
    <Seascape variant="full" />

    <!-- 01 · HERO — sobrio, bajo el cielo del atardecer -->
    <section class="hhero" data-sky-hero aria-labelledby="home-title">
      <SkyHeroFx />



      <div class="hhero-inner">
        <p class="eyebrow hhero-eyebrow">{t.hero.eyebrow}</p>
        <h1 id="home-title" class="hhero-title">
          <span>{t.hero.titlePre}</span><span class="hhero-mark text-sunset"
            >{t.hero.titleMark}</span
          ><span>{t.hero.titlePost}<span class="hhero-caret" aria-hidden="true"
              >_</span
            ></span
          >
        </h1>
        <p class="hhero-lead">{t.hero.description}</p>

        <div class="hhero-actions">
          <CTA href="#contact">{t.nav.cta}</CTA>
          <a class="hhero-more" href="#services">{t.hero.secondary}</a>
        </div>
      </div>
    </section>

    <!-- 02 · ABOUT — el CIELO: cirros de atardecer (tono dusk) -->
    <About lang={lang} />

    <!-- 03 · PROJECTS — el HORIZONTE: la banda de fuego y el escaparate. El
         caso destacado monta su propia escena (el sol con su sextante). -->
    <Projects lang={lang} />

    <!-- 04 · SERVICES — el MAR: la hondura, olas a contracorriente y la rosa
         de los vientos como marca de agua. La sección monta su propia escena
         (olas + rosa) junto con el contenido. -->
    <Services lang={lang} />
  </main>

  <Footer lang={lang} />

  <LangNotice lang={lang} />
</Layout>
