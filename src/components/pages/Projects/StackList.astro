---
/**
 * StackList — el stack de una pieza, en la voz visual del Home.
 *
 * Regla: TODO íconos o TODO texto, nunca mezclado. Si cada tecnología de la
 * lista tiene logotipo en el registro, se pintan las placas (idéntico a la
 * sección de servicios del Home); si alguna no lo tiene (p. ej. una técnica
 * como «SSG», que no es una marca con logo), la lista entera cae a etiquetas
 * de texto. Así una fila nunca queda con un logo suelto junto a palabras.
 */
import { TECH, techKey, allHaveIcons } from "../../../data/tech";

interface Props {
  items: string[];
}

const { items } = Astro.props;
const allIcons = allHaveIcons(items);
---

{
  allIcons ? (
    <ul class="bt-stack" role="list">
      {items.map((raw) => {
        const tech = TECH[techKey(raw)];
        return (
          <li class="bt-tech">
            <img
              src={tech.src}
              alt={tech.name}
              width="24"
              height="24"
              loading="lazy"
              decoding="async"
            />
            <span class="bt-tech-name" aria-hidden="true">
              {tech.name}
            </span>
          </li>
        );
      })}
    </ul>
  ) : (
    <ul class="bt-tags" role="list">
      {items.map((raw) => (
        <li class="bt-tag">{raw}</li>
      ))}
    </ul>
  )
}
